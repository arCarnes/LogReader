<Application x:Class="LogReader.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LogReader.App.Converters"
             xmlns:models="clr-namespace:LogReader.Core.Models;assembly=LogReader.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose"
             >
    <Application.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:HexColorToBrushConverter x:Key="HexColorToBrush"/>
            <conv:LessThanConverter x:Key="LessThan"/>
            <Visibility x:Key="LogLineNumbersVisibilityResource">Visible</Visibility>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F8FA"/>
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F4F6F8"/>
            <SolidColorBrush x:Key="AppElevatedSurfaceBrush" Color="#FBFCFD"/>
            <SolidColorBrush x:Key="AppViewportContentBrush" Color="#FCFDFE"/>
            <SolidColorBrush x:Key="AppViewportCanvasBrush" Color="#F7F8FA"/>
            <SolidColorBrush x:Key="AppViewportChromeBrush" Color="#F5F7FA"/>
            <SolidColorBrush x:Key="AppDashboardContentBrush" Color="#F7F8FA"/>
            <SolidColorBrush x:Key="AppScrollBarThumbBrush" Color="#AEBECB"/>
            <SolidColorBrush x:Key="AppScrollBarThumbHoverBrush" Color="#8FA4B8"/>
            <SolidColorBrush x:Key="AppBranchRowBrush" Color="#F9FBFD"/>
            <SolidColorBrush x:Key="AppSearchPanelSurfaceBrush" Color="#F1F5F8"/>
            <SolidColorBrush x:Key="AppFileHeaderBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="AppTableHeaderBrush" Color="#F7F8FA"/>
            <SolidColorBrush x:Key="AppBorderBrush" Color="#D6DEE6"/>
            <SolidColorBrush x:Key="AppDividerBrush" Color="#E6EBF0"/>
            <SolidColorBrush x:Key="AppSearchPanelBorderBrush" Color="#CDD8E2"/>
            <SolidColorBrush x:Key="AppResultsDividerBrush" Color="#C6D2DD"/>
            <SolidColorBrush x:Key="AppFocusBorderBrush" Color="#9CB8D4"/>
            <SolidColorBrush x:Key="AppTextBrush" Color="#1F2937"/>
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#5B6470"/>
            <SolidColorBrush x:Key="AppPlaceholderTextBrush" Color="#8F99A5"/>
            <SolidColorBrush x:Key="AppDisclosureBrush" Color="#666666"/>
            <SolidColorBrush x:Key="AppSelectedRowBrush" Color="#EAF4FE"/>
            <SolidColorBrush x:Key="AppSelectedMemberBrush" Color="#CFE1F4"/>
            <SolidColorBrush x:Key="AppViewportSelectionBrush" Color="#B0D4FF"/>
            <SolidColorBrush x:Key="AppSelectedMemberTextBrush" Color="#143A5A"/>
            <SolidColorBrush x:Key="AppErrorBrush" Color="#CC2222"/>
            <SolidColorBrush x:Key="AppControlSurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppControlHoverBrush" Color="#EAF4FE"/>
            <SolidColorBrush x:Key="AppControlPressedBrush" Color="#DCEAF8"/>
            <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#8F99A5"/>
            <SolidColorBrush x:Key="AppWarningTextBrush" Color="#B7791F"/>
            <SolidColorBrush x:Key="AppWarningSurfaceBrush" Color="#FFF8E7"/>
            <SolidColorBrush x:Key="AppWarningBorderBrush" Color="#E5C07B"/>
            <SolidColorBrush x:Key="AppInfoTextBrush" Color="#355C7D"/>
            <FontFamily x:Key="LogFontFamilyResource">Consolas</FontFamily>
            <sys:Double x:Key="LogViewportFontSizeResource">12</sys:Double>
            <sys:Double x:Key="DashboardPrimaryFontSizeResource">12</sys:Double>
            <sys:Double x:Key="DashboardMemberFontSizeResource">11</sys:Double>
            <sys:Double x:Key="DashboardDetailFontSizeResource">10</sys:Double>
            <sys:Boolean x:Key="SearchMatchHighlightingEnabledResource">True</sys:Boolean>
            <x:Static x:Key="AppThemeResource" Member="models:AppTheme.Default"/>
            <SolidColorBrush x:Key="SearchMatchHighlightBrushResource" Color="#FFF59D"/>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="Icon" Value="pack://application:,,,/Assets/favicon.ico"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AppControlSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource AppSurfaceBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          RecognizesAccessKey="True" Opacity="0.65"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource AppControlSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="TextBoxBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              Focusable="False"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource AppFocusBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource AppControlSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="DropDownButton"
                                              Focusable="False"
                                              ClickMode="Press"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1">
                                                <Path x:Name="DropDownArrow" Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,9,0" Fill="{DynamicResource AppTextBrush}"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppControlHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppControlPressedBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                                                    <Setter TargetName="DropDownArrow" Property="Fill" Value="{DynamicResource AppDisabledTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="8,2,26,2"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False">
                                    <Border Background="{DynamicResource AppControlSurfaceBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer CanContentScroll="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="{DynamicResource AppControlSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="Padding" Value="6,3"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppControlHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSelectedRowBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <BulletDecorator Background="Transparent">
                                        <BulletDecorator.Bullet>
                                            <Grid Width="13" Height="13" VerticalAlignment="Center">
                                                <Rectangle Stroke="{DynamicResource AppDisabledTextBrush}" Fill="{DynamicResource AppSurfaceBrush}"/>
                                                <Path x:Name="CheckMark" Margin="3" Stroke="{DynamicResource AppDisabledTextBrush}" StrokeThickness="2" Data="M 0 4 L 3 7 L 8 0" Stretch="Uniform" Visibility="Collapsed"/>
                                                <Rectangle x:Name="IndeterminateMark" Margin="3" Fill="{DynamicResource AppDisabledTextBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                        </BulletDecorator.Bullet>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          RecognizesAccessKey="True"/>
                                    </BulletDecorator>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="{x:Null}">
                                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <BulletDecorator Background="Transparent">
                                        <BulletDecorator.Bullet>
                                            <Grid Width="13" Height="13" VerticalAlignment="Center">
                                                <Ellipse Stroke="{DynamicResource AppDisabledTextBrush}" Fill="{DynamicResource AppSurfaceBrush}"/>
                                                <Ellipse x:Name="CheckMark" Margin="4" Fill="{DynamicResource AppDisabledTextBrush}" Visibility="Collapsed"/>
                                                <Rectangle x:Name="IndeterminateMark" Margin="3" Fill="{DynamicResource AppDisabledTextBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                        </BulletDecorator.Bullet>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          RecognizesAccessKey="True"/>
                                    </BulletDecorator>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="{x:Null}">
                                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource AppControlSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ScrollViewer"
                                              Padding="{TemplateBinding Padding}"
                                              Focusable="False">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Background" Value="{DynamicResource AppControlSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="StatusBar">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            </Style>
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource AppControlSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <!-- The native template paints a fixed light icon gutter behind the themed menu items. -->
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Margin="1,0"
                                              Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type FrameworkElement}, ResourceId=MenuScrollViewer}}">
                                    <ItemsPresenter Margin="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="{DynamicResource AppControlSurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ToolBarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            </Style>
            <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="FontFamily" Value="{DynamicResource LogFontFamilyResource}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource AppElevatedSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            </Style>
            <Style x:Key="LogText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource LogFontFamilyResource}"/>
                <Setter Property="FontSize" Value="{DynamicResource LogViewportFontSizeResource}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
