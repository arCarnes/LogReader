<Window x:Class="LogReader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:LogReader.App.Views"
        Title="WeezTail"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Drop="OnFileDrop"
        DragOver="OnDragOver">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}"/>
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding SelectPreviousTabCommand}"/>
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding SelectNextTabCommand}"/>
        <KeyBinding Key="F10" Command="{Binding ToggleFocusModeCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <ControlTemplate x:Key="MainToolBarTemplate" TargetType="ToolBar">
            <Grid Background="{DynamicResource AppSurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                </Grid.ColumnDefinitions>
                <Thumb x:Name="ToolBarThumb" Grid.Column="0" Cursor="SizeAll">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{DynamicResource AppSurfaceBrush}">
                                <Path Data="M4,5 L4,16 M7,5 L7,16"
                                      Stroke="{DynamicResource AppMutedTextBrush}"
                                      StrokeThickness="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <ToolBarPanel x:Name="PART_ToolBarPanel"
                              Grid.Column="1"
                              IsItemsHost="True"/>
                <ToggleButton x:Name="OverflowButton"
                              Grid.Column="2"
                              IsEnabled="{TemplateBinding HasOverflowItems}"
                              IsChecked="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"
                              FocusVisualStyle="{x:Null}"
                              ToolTip="More toolbar commands">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="OverflowSurface" Background="{DynamicResource AppSurfaceBrush}">
                                <Path Data="M3,6 L7,10 L11,6 M3,10 L7,14 L11,10"
                                      Stroke="{DynamicResource AppMutedTextBrush}"
                                      StrokeThickness="1.5"
                                      Width="14" Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OverflowSurface" Property="Background" Value="{DynamicResource AppControlHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="OverflowSurface" Property="Background" Value="{DynamicResource AppControlPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="OverflowPopup"
                       PlacementTarget="{Binding ElementName=OverflowButton}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Background="{DynamicResource AppControlSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            Padding="2">
                        <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel"
                                              WrapWidth="240"
                                              KeyboardNavigation.TabNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <ToolBarTray>
                <ToolBar Band="0" Template="{StaticResource MainToolBarTemplate}">
                    <Button Content="Open Log Files" Command="{Binding OpenFileCommand}" IsEnabled="{Binding AreLoadAffectingActionsEnabled}" Style="{StaticResource ToolBarButton}" ToolTip="Open a log file"/>
                    <Button Content="Bulk Open Files" Command="{Binding BulkOpenAdHocFilesCommand}" IsEnabled="{Binding AreLoadAffectingActionsEnabled}" Style="{StaticResource ToolBarButton}" ToolTip="Paste many file paths to open them in Ad Hoc"/>
                    <Separator/>
                    <Button Content="Export View" Command="{Binding ExportViewCommand}" Style="{StaticResource ToolBarButton}" ToolTip="Export the current dashboard view"/>
                    <Button Content="Import View" Command="{Binding ImportViewCommand}" IsEnabled="{Binding AreLoadAffectingActionsEnabled}" Style="{StaticResource ToolBarButton}" ToolTip="Import a saved dashboard view"/>
                    <Separator/>
                    <Button Content="Hotkeys" Click="ShowControls_Click" Style="{StaticResource ToolBarButton}" ToolTip="Show keyboard shortcuts"/>
                    <Button Content="MCP Server" Click="OpenMcpHelp" Style="{StaticResource ToolBarButton}" ToolTip="MCP setup, readiness, and log-tool help"/>
                    <Button Content="Settings" Click="OpenSettings" Style="{StaticResource ToolBarButton}"/>
                </ToolBar>
            </ToolBarTray>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" x:Name="GroupsPanelColumn"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <view:DashboardTreeView Grid.Column="0"/>

                <GridSplitter Grid.Column="1"
                          Width="10"
                          Margin="-5,0,-5,0"
                          Background="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Panel.ZIndex="1"
                          DragCompleted="GroupsSplitter_DragCompleted"
                          ToolTip="Drag to resize dashboards pane.">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Width="1"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource AppBorderBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGroupsPanelOpen}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="260" x:Name="SearchPanelRow"/>
                </Grid.RowDefinitions>
                <view:TabStripView Grid.Row="0"/>
                <view:LogViewportView Grid.Row="1"/>
                <GridSplitter Grid.Row="2"
                              Height="10"
                              Margin="0,-5,0,-5"
                              Background="Transparent"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True"
                              Panel.ZIndex="1"
                              DragCompleted="SearchSplitter_DragCompleted"
                              ToolTip="Drag to resize search workspace.">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="{TemplateBinding Background}">
                                <Border Height="1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AppBorderBrush}"/>
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchPanelOpen}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <view:SearchWorkspaceView x:Name="SearchWorkspace">
                        <view:SearchWorkspaceView.Style>
                            <Style TargetType="view:SearchWorkspaceView">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Grid.Row" Value="1"/>
                                <Setter Property="Grid.RowSpan" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchPanelOpen}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </view:SearchWorkspaceView.Style>
                    </view:SearchWorkspaceView>
                    <Button Grid.RowSpan="2"
                            Height="32"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Command="{Binding ToggleSearchPanelCommand}"
                            ToolTip="Open search pane"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchPanelOpen}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE721;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Row="0"
                            Height="14"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Command="{Binding ToggleSearchPanelCommand}"
                            ToolTip="Collapse search pane"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0"
                            Content="&#x25BC;">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchPanelOpen}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TabCountText}"/>
                    <TextBlock Grid.Column="1" Text="{Binding AppVersionText}"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
