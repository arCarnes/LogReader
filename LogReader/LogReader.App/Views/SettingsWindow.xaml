<Window x:Class="LogReader.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:LogReader.App.Services"
        xmlns:vm="clr-namespace:LogReader.App.ViewModels"
        xmlns:conv="clr-namespace:LogReader.App.Converters"
        services:WindowTitleBarTheme.Theme="{DynamicResource AppThemeResource}"
        services:WindowTitleBarTheme.IsEnabled="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        Title="Settings" Width="860" Height="760"
        MinWidth="780" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexColorToBrush"/>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <DataTemplate x:Key="ColorButtonContentTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="18" Height="16" BorderThickness="1"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        Background="{Binding Converter={StaticResource HexColorToBrush}}"/>
                <TextBlock Text="{Binding}" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ColorSelectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="112"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ContentTemplate" Value="{StaticResource ColorButtonContentTemplate}"/>
        </Style>
        <Style x:Key="RecentColorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- General -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
             <Grid.RowDefinitions>
                 <RowDefinition Height="Auto"/>
                 <RowDefinition Height="Auto"/>
                 <RowDefinition Height="Auto"/>
                 <RowDefinition Height="Auto"/>
             </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="General" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Default open directory"/>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding DefaultOpenDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4,2"
                         IsReadOnly="True"
                         Background="{DynamicResource AppSurfaceBrush}"/>
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseDefaultDirectoryCommand}"
                        Padding="8,4" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Content="Clear" Command="{Binding ClearDefaultDirectoryCommand}"
                        Padding="8,4" Margin="4,0,0,0"/>
            </Grid>

             <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Log font"/>
             <Grid Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                 <ComboBox Grid.Column="0"
                           Margin="0,0,8,0"
                           ItemsSource="{x:Static vm:SettingsViewModel.LogFontOptions}"
                           SelectedItem="{Binding LogFontFamily, Mode=TwoWay}"/>
                 <ComboBox Grid.Column="1"
                           Width="96"
                           ItemsSource="{x:Static vm:SettingsViewModel.LogFontSizeOptions}"
                           SelectedItem="{Binding LogFontSize, Mode=TwoWay}"/>
             </Grid>

             <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Dashboard file labels"/>
             <CheckBox Grid.Row="3"
                       Grid.Column="1"
                       Margin="0,10,0,0"
                       Content="Show full paths in dashboards when space allows"
                       IsChecked="{Binding ShowFullPathsInDashboard, Mode=TwoWay}"/>

         </Grid>

        <!-- Appearance -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Appearance" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Dashboards font size"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Width="96" HorizontalAlignment="Left"
                      ItemsSource="{x:Static vm:SettingsViewModel.DashboardFontSizeOptions}"
                      SelectedItem="{Binding DashboardFontSize, Mode=TwoWay}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Theme" Margin="0,8,10,0"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                <RadioButton x:Name="DefaultThemeOption" Content="Default" GroupName="AppearanceTheme"
                             IsChecked="{Binding IsDefaultTheme, Mode=TwoWay}" Margin="0,0,16,0"/>
                <RadioButton x:Name="EasyReadingThemeOption" Content="Easy Reading" GroupName="AppearanceTheme"
                             IsChecked="{Binding IsEasyReadingTheme, Mode=TwoWay}" Margin="0,0,16,0"/>
                <RadioButton x:Name="DarkThemeOption" Content="Dark" GroupName="AppearanceTheme"
                             IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="UI Elements" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Search results"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                <CheckBox Content="Highlight matches"
                          IsChecked="{Binding EnableSearchMatchHighlighting, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                <Button x:Name="SearchMatchColorButton" Style="{StaticResource ColorSelectionButton}"
                        Content="{Binding SearchMatchHighlightColor}" Click="OpenColorPalette_Click"
                        ToolTip="Search match highlight color"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Line Highlighting -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Line Highlighting" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="+ Add Rule"
                            Command="{Binding AddRuleCommand}"
                            Padding="8,3" HorizontalAlignment="Right"/>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Pattern" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Regex" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Case" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Color" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="4,0,0,0"/>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding HighlightRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HighlightRuleViewModel}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="128"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4,2" Margin="4,0"/>

                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsRegex}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <CheckBox Grid.Column="3" IsChecked="{Binding CaseSensitive}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <Button Grid.Column="4" Style="{StaticResource ColorSelectionButton}"
                                            Content="{Binding Color}" Tag="{Binding}"
                                            Margin="4,0" VerticalAlignment="Center"
                                            Click="OpenColorPalette_Click" ToolTip="Line highlight color"/>

                                    <Button Grid.Column="5" Content="X" Padding="3,1" FontSize="11"
                                            Foreground="{DynamicResource AppErrorBrush}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Date Rolling Replacement Patterns -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Date Rolling Replacement Patterns" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="+ Add Pattern"
                            Command="{Binding AddDateRollingPatternCommand}"
                            Padding="8,3" HorizontalAlignment="Right"/>
                </DockPanel>

                <TextBlock Grid.Row="1" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,6" TextWrapping="Wrap">
                    Replace must include a date placeholder such as {yyyyMMdd} or {yyyy-MM-dd_HHmmss}. Patterns are tried from top to bottom.
                </TextBlock>

                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="1" Text="Find" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Replace" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="Order" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="4,0,0,0"/>
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DateRollingPatterns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReplacementPatternViewModel}">
                                <StackPanel Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="4,2" Margin="0,0,4,0">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNameInvalid}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AppErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding FindPattern, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="4,2" Margin="0,0,4,0"
                                                 FontFamily="Consolas"/>

                                        <TextBox Grid.Column="2"
                                                 Text="{Binding ReplacePattern, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="4,2" Margin="0,0,4,0"
                                                 FontFamily="Consolas">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReplacePatternInvalid}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AppErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="&#x25B2;" Width="30" Padding="2,1" FontSize="10" Margin="0,0,4,0" ToolTip="Move pattern up"
                                                    Command="{Binding DataContext.MoveDateRollingPatternUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="&#x25BC;" Width="30" Padding="2,1" FontSize="10" ToolTip="Move pattern down"
                                                    Command="{Binding DataContext.MoveDateRollingPatternDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>

                                        <Button Grid.Column="4" Content="X" Padding="3,1" FontSize="11"
                                                Foreground="{DynamicResource AppErrorBrush}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveDateRollingPatternCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ValidationError}"
                                                   Foreground="{DynamicResource AppErrorBrush}" FontSize="10"
                                                   Margin="4,0,4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- Import / Export / OK / Cancel -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Import..." Width="88" Padding="4,6" Margin="0,0,8,0"
                        Command="{Binding ImportSettingsCommand}"/>
                <Button Content="Export..." Width="88" Padding="4,6"
                        Command="{Binding ExportSettingsCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="80" Padding="4,6" Margin="0,0,8,0" IsDefault="True" Click="OK_Click"/>
                <Button Content="Cancel" Width="80" Padding="4,6" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <Popup x:Name="ColorPalettePopup" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" KeyDown="ColorPalettePopup_KeyDown">
            <Border Background="{DynamicResource AppElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="10" MinWidth="230">
                <StackPanel>
                    <TextBlock Text="Recent colors" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="RecentColorItems" ItemsSource="{Binding RecentHighlightColors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" MaxWidth="256"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RecentColorButton}"
                                        Background="{Binding Converter={StaticResource HexColorToBrush}}"
                                        Tag="{Binding}" Click="RecentColor_Click" ToolTip="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No recent colors yet" Foreground="{DynamicResource AppMutedTextBrush}"
                               Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentHighlightColors.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Height="1" Background="{DynamicResource AppDividerBrush}" Margin="0,2,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MoreColorsButton" Content="More colors..." Padding="8,4"
                                Click="PickCustomColor_Click"/>
                        <Button x:Name="ClearRecentColorsButton" Content="Clear recent" Padding="8,4"
                                Margin="8,0,0,0" Command="{Binding ClearRecentHighlightColorsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
