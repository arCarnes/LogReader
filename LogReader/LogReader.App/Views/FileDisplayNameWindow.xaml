<Window x:Class="LogReader.App.Views.FileDisplayNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:LogReader.App.Services"
        services:WindowTitleBarTheme.Theme="{DynamicResource AppThemeResource}"
        services:WindowTitleBarTheme.IsEnabled="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        Title="Set Display Name" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Display name" FontWeight="SemiBold"/>
        <TextBox x:Name="NameBox" Margin="0,8,0,12"/>
        <TextBlock Text="Actual file path" Foreground="{DynamicResource AppMutedTextBrush}"/>
        <TextBox x:Name="PathBox" Margin="0,6,0,12" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="This name is shared across dashboards, tabs, and MCP. Leave it blank to use the filename."
                   TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}"/>
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="{DynamicResource AppErrorBrush}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
