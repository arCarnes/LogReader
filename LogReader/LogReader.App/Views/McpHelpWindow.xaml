<Window x:Class="LogReader.App.Views.McpHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCP Server"
        Width="780"
        Height="700"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="WeezTail MCP Server"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Margin="0,5,0,14"
                       Foreground="{StaticResource AppMutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="Give a trusted agent bounded, read-only access to logs saved in your WeezTail dashboard tree."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Border BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource AppElevatedSurfaceBrush}"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Local setup"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Margin="0,3,0,10"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="This summarizes the current app layout. It does not start or connect to the MCP server."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="MCP sidecar" FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Column="1" Text="{Binding ServerStatusText}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="Storage" FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StorageStatusText}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="Saved dashboards" FontWeight="SemiBold" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DashboardStatusText}" Margin="0,2"/>
                        </Grid>
                        <TextBlock Margin="0,12,0,4" Text="Server executable" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ServerExecutablePath}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 Padding="6,4"
                                 HorizontalScrollBarVisibility="Auto"/>
                        <Button Content="Copy server path"
                                Width="130"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Padding="8,4"
                                Click="CopyServerPath_Click"
                                ToolTip="Copy the absolute WeezTail.Mcp.exe path"/>
                    </StackPanel>
                </Border>

                <GroupBox Header="Getting started" Margin="0,0,0,12" Padding="10">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"
                                   Text="1. Save the folders, dashboards, and log files you want an agent to access in WeezTail."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,5,0,2"
                                   Text="2. Add the server executable shown above to Codex, Claude Code, or another trusted MCP client as a local stdio server with no arguments."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,5,0,2"
                                   Text="3. Ask the agent to search a hierarchy such as production &gt; app1 &gt; instance1. The full guide contains current client commands and a first-search example."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="How agent log access works" Margin="0,0,0,12" Padding="10">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,8"
                                   Text="WeezTail presents configured logs as folder &gt; dashboard &gt; file. The agent first discovers that tree, resolves the requested display hierarchy to a stable ID, and then uses the ID for bounded reads."/>
                        <TextBlock Text="Discover" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Margin="16,1,0,6"
                                   Text="List the saved tree and find the folder, dashboard, or file you named."/>
                        <TextBlock Text="Search" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Margin="16,1,0,6"
                                   Text="Search one selected file, all files in a dashboard, or every descendant under a folder."/>
                        <TextBlock Text="Read lines" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Margin="16,1,0,6"
                                   Text="Retrieve a small line range around a result when more context is needed."/>
                        <TextBlock Text="Read tail" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Margin="16,1,0,6"
                                   Text="Read or poll the end of one configured file with a short-lived cursor."/>
                        <TextBlock Text="Check status" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Margin="16,1,0,0"
                                   Text="Report catalog readiness, effective limits, and this process's bounded cache usage."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Technical details" Padding="10">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,6"
                                   Text="Each MCP client starts a separate WPF-free WeezTail.Mcp.exe process and communicates through stdin/stdout. The sidecar does not start, activate, or connect to this UI."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,6"
                                   Text="Requests accept configured typed IDs rather than arbitrary file paths. Membership is revalidated before file I/O, and physical paths and storage roots are omitted from results."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,6"
                                   Text="Searches, reads, response text, time, concurrency, and index caches are bounded. Partial and truncated responses are normal when a limit is reached."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,2"
                                   Text="Log text and saved labels are untrusted data. Agents should not treat their contents as instructions, and WeezTail cannot redact application-specific secrets contained in logs."/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button Content="Open full guide"
                    Width="130"
                    HorizontalAlignment="Left"
                    Padding="8,5"
                    Click="OpenGuide_Click"
                    ToolTip="Open the detailed MCP getting-started guide in your default browser"/>
            <Button Content="Close"
                    Width="90"
                    HorizontalAlignment="Right"
                    Padding="8,5"
                    IsDefault="True"
                    IsCancel="True"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
