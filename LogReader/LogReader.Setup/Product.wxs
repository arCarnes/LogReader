<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
    <Package Name="WeezTail"
           Manufacturer="Austin Carnes"
           Version="$(var.ProductVersion)"
           UpgradeCode="93530218-C7A8-4BC1-B4C0-8A670BA3776A"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of WeezTail is already installed." />
    <!-- Release MSI versions must advance in the first three version fields. Same-version related products are detected and blocked to avoid duplicate installed products. -->
    <Upgrade Id="93530218-C7A8-4BC1-B4C0-8A670BA3776A">
      <UpgradeVersion Minimum="$(var.ProductVersion)"
                      IncludeMinimum="yes"
                      Maximum="$(var.ProductVersion)"
                      IncludeMaximum="yes"
                      OnlyDetect="yes"
                      Property="LOGREADER_SAME_VERSION_DETECTED" />
    </Upgrade>
    <Launch Condition="Installed OR NOT LOGREADER_SAME_VERSION_DETECTED"
            Message="This WeezTail version is already installed. Uninstall the existing copy first, or install a newer version." />
    <MediaTemplate EmbedCab="yes" />
    <Launch Condition="VersionNT64" Message="WeezTail requires a 64-bit version of Windows." />

    <Icon Id="ProductIcon" SourceFile="..\LogReader.App\Assets\favicon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="LOGREADERDATAROOT" Secure="yes" />
    <Property Id="LOGREADERUSERSELECTIONPATH" Secure="yes" />
    <Property Id="REMOVELOGREADERDATA" Value="0" Secure="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Binary Id="InstallerActionsVbs" SourceFile="InstallerActions.vbs" />

    <CustomAction Id="MigrateLegacyStorageSelection"
                  BinaryRef="InstallerActionsVbs"
                  VBScriptCall="MigrateLegacyStorageSelection"
                  Execute="immediate"
                  Return="check" />
    <CustomAction Id="PromptRemoveData"
                  BinaryRef="InstallerActionsVbs"
                  VBScriptCall="PromptRemoveData"
                  Execute="immediate"
                  Return="check" />
    <CustomAction Id="RemoveDataFolders"
                  BinaryRef="InstallerActionsVbs"
                  VBScriptCall="RemoveDataFolders"
                  Execute="immediate"
                  Return="check" />

    <ui:WixUI Id="WixUI_FeatureTree" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WeezTail">
        <Component Id="MainExecutableComponent" Guid="1B9D94A7-1C2C-414C-B345-F4F59023A1AC">
          <File Id="LogReaderExecutableFile"
                Name="WeezTail.exe"
                Source="$(var.AppPublishDir)\WeezTail.exe"
                KeyPath="yes"
                Checksum="yes" />
        </Component>
        <Component Id="InstallConfigComponent"
                   Guid="F50B73C0-DD35-47B4-A606-B237E70740ED"
                   NeverOverwrite="yes">
          <File Id="InstallConfigFile"
                Name="WeezTail.install.json"
                Source="$(var.AppPublishDir)\WeezTail.install.json"
                KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="LogReaderProgramMenuFolder" Name="WeezTail">
        <Component Id="StartMenuShortcutComponent" Guid="1BF70061-FC8E-4F96-8240-1902BAE8EDEE">
          <Shortcut Id="StartMenuShortcut"
                    Name="WeezTail"
                    Description="Launch WeezTail"
                    Target="[INSTALLFOLDER]WeezTail.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="ProductIcon"
                    Advertise="no" />
          <RemoveFolder Id="RemoveStartMenuShortcutFolder"
                        Directory="LogReaderProgramMenuFolder"
                        On="uninstall" />
          <!-- Non-advertised shortcuts under ProgramMenuFolder are per-user MSI resources and use HKCU key paths per ICE38/ICE43. -->
          <RegistryValue Root="HKCU"
                         Key="Software\WeezTail\Installer"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="2F4FA11F-9B9A-4D0C-BF46-00C4B4E847E4">
        <Shortcut Id="DesktopShortcut"
                  Name="WeezTail"
                  Description="Launch WeezTail"
                  Target="[INSTALLFOLDER]WeezTail.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ProductIcon"
                  Advertise="no" />
        <!-- Non-advertised shortcuts under DesktopFolder are per-user MSI resources and use HKCU key paths per ICE38/ICE43. -->
        <RegistryValue Root="HKCU"
                       Key="Software\WeezTail\Installer"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature"
             Title="WeezTail"
             Description="Core WeezTail application files."
             Level="1"
             Display="expand"
             ConfigurableDirectory="INSTALLFOLDER"
             AllowAbsent="no"
             AllowAdvertise="no">
      <ComponentRef Id="MainExecutableComponent" />
      <ComponentRef Id="InstallConfigComponent" />
      <Feature Id="StartMenuShortcutFeature"
               Title="Start menu shortcut"
               Description="Adds a Start menu shortcut for WeezTail."
               Level="1"
               AllowAdvertise="no">
        <ComponentRef Id="StartMenuShortcutComponent" />
      </Feature>
      <Feature Id="DesktopShortcutFeature"
               Title="Desktop shortcut"
               Description="Adds a desktop shortcut for WeezTail."
               Level="2"
               AllowAdvertise="no">
        <ComponentRef Id="DesktopShortcutComponent" />
      </Feature>
    </Feature>

    <InstallUISequence>
      <Custom Action="PromptRemoveData" Before="ExecuteAction" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt;= 5" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <!-- Capture legacy absolute storage metadata while the related LogReader product is still registered. -->
      <Custom Action="MigrateLegacyStorageSelection"
              Before="RemoveExistingProducts"
              Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
      <Custom Action="RemoveDataFolders" Before="RemoveFiles" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND REMOVELOGREADERDATA = &quot;1&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
