<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>WeezTail.Setup</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US</Cultures>
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\WeezTail.MsiPayload</AppPublishDir>
    <InstallerActionsPath Condition="'$(InstallerActionsPath)' == ''">$(MSBuildThisFileDirectory)..\artifacts\installer-actions\InstallerActions.dll</InstallerActionsPath>
    <DefineConstants>AppPublishDir=$(AppPublishDir);InstallerActionsPath=$(InstallerActionsPath);ProductVersion=$(Version)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.6" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
  </ItemGroup>
</Project>
